# ─────────────────────────────────────────────────────────────
# Trading Mind — variáveis de ambiente
# Copie para .env.local. Tudo é OPCIONAL: sem estas variáveis o app
# roda em modo demonstração (dados no navegador) e a IA usa o motor local.
# ─────────────────────────────────────────────────────────────

# Supabase (autenticação, banco e storage reais)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# IA — Psicólogo de Trading (Anthropic). Sem a chave, usa análise local.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
