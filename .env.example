# ─── Geração de conteúdo (Claude / Anthropic) ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Modelo usado para escrever os posts. Padrão: claude-sonnet-5 (bom custo/qualidade
# para alto volume). Alternativas: claude-opus-5 (mais caro/capaz), claude-haiku-4-5
# (mais barato). Se usar haiku-4-5, é o mais econômico para 20 posts/dia.
ANTHROPIC_MODEL=claude-sonnet-5

# Idioma dos posts (ex.: "português do Brasil", "English")
POST_LANGUAGE=português do Brasil

# @ (handle) acrescentado ao final de cada post como assinatura.
POST_HANDLE=@thiago.cunhaff

# ─── Plataformas onde publicar (lista separada por vírgula) ──────────────────
# Valores possíveis: threads, instagram
PLATFORMS=threads

# ─── Threads (Meta) ─────────────────────────────────────────────────────────
# Conta business/creator do Threads + token de acesso de longa duração.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ─── Instagram (Meta Graph API) ─────────────────────────────────────────────
# Conta Instagram Business/Creator conectada a uma Página do Facebook.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Necessária para PUBLICAR IMAGEM em qualquer plataforma (Threads e Instagram):
# tanto o Instagram quanto o Threads exigem uma URL pública de imagem. Usamos o
# imgbb para hospedar o card gerado. Crie uma chave grátis em https://api.imgbb.com/
# Sem esta chave, o Threads publica só texto e o Instagram é ignorado.
IMGBB_API_KEY=

# ─── Renovação automática do token (opcional, recomendado) ──────────────────
# Ver SETUP_INSTAGRAM.md (Parte 7). Só usados pelo workflow de renovação.
FB_APP_ID=
FB_APP_SECRET=
# Personal Access Token do GitHub com escrita em "Secrets" do repositório.
GH_PAT=

# ─── Comportamento ──────────────────────────────────────────────────────────
# Se "true", gera o conteúdo mas NÃO publica (útil para testar).
DRY_RUN=false
# Sobrescreve o tipo de conteúdo do post: motivacional | mercado | educacional
# Se vazio, é escolhido aleatoriamente (com pesos definidos em config.py).
POST_TYPE=
